{
  "manifest_version": 3,
  "name": "foxpaw demo",
  "version": "0.1.0",
  "description": "Read a web page, act on it like a person, and check the result, from a Firefox extension.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxpaw@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "foxpaw demo"
  },
  "sidebar_action": {
    "default_title": "foxpaw demo",
    "default_panel": "sidebar.html"
  }
}
