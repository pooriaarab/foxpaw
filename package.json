{
  "name": "foxpaw",
  "version": "0.1.16",
  "description": "Firefox browser automation for extensions: page snapshots, form filling, GLiNER2 choosers, stale-action checks, and result verification.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/foxpaw.git"
  },
  "homepage": "https://github.com/pooriaarab/foxpaw#readme",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:ext && pnpm lint:ext && pnpm check:amo",
    "build:ext": "node scripts/build-ext.mjs",
    "lint:ext": "web-ext lint -s dist-ext --warnings-as-errors",
    "check:amo": "node scripts/amo-listing.mjs check",
    "e2e": "node scripts/build-ext.mjs --e2e && node e2e/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "create-foxkit": "^0.1.0",
    "esbuild": "^0.28.2",
    "web-ext": "^10.7.0"
  },
  "keywords": [
    "firefox",
    "webextensions",
    "browser-automation",
    "form-filling",
    "page-snapshot",
    "accessibility",
    "shadow-dom",
    "typescript",
    "gliner2",
    "foxmind",
    "rule-chooser",
    "result-verification",
    "autocomplete",
    "date-picker",
    "browser-agent"
  ]
}
